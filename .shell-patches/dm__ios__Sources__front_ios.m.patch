diff --git a/dm/ios/Sources/front_ios.m b/dm/ios/Sources/front_ios.m
--- a/dm/ios/Sources/front_ios.m
+++ b/dm/ios/Sources/front_ios.m
@@ -24,6 +24,9 @@
 const char *front_ios_boot_message(void);   // main.m: why a build that keeps the game files off the IPA found none usable (NULL = the generic hint)
 const char *front_ios_device_check(void);   // main.m: why this device cannot run the games (its GPU has no BC textures; NULL = supported); makes the first Metal device
 bool dm_show_launcher(void *view_controller, void (*done)(void));   // Launcher.swift: false = no launcher (no dm/launcher.json, or DM_LAUNCHER=0)
+int dm_shell_library_needed(void);   // main.m: zero or several games in the bundle -- the library picks one instead of starting at launch
+void dm_show_library(void *view_controller, void (*picked)(const char *tid), void (*cancelled)(void));   // Library.swift
+void dm_cheats_after_launcher(void);   // hle_cheats.c: the load dm_cheats_init skipped at launch, run now that the screen is done
 
 static CAMetalLayer *g_layer;
 static void front_ios_notify_setup(void);
@@ -97,6 +100,16 @@
 static DmRootVC *g_root;
 static CGFloat g_picture_aspect = DM_PICTURE_16_9;   // the presented picture's width / height (front_picture_shape); main thread
 static void launcher_done(void) { [g_root startGame]; }
+// The library picked a game: dm_shell_start_game() has already set its environment and begun the host's early loading (Library.swift),
+// so only that game's settings screen is left before the game view.
+static void library_picked(const char *tid) {
+    (void)tid;
+    if (!g_root) return;
+    void (^go)(void) = ^{ if (!dm_show_launcher((__bridge void *)g_root, launcher_done)) [g_root startGame]; };
+    if (g_root.presentedViewController) [g_root dismissViewControllerAnimated:YES completion:go]; else go();
+}
+// Library.swift dismisses the page before calling this, so it is shown again: with no game in the app the library is all there is.
+static void library_cancelled(void) { if (g_root) dm_show_library((__bridge void *)g_root, library_picked, library_cancelled); }
 @implementation DmRootVC
 - (void)loadView { self.view = [DmRootView new]; }
 - (void)showHint:(NSString *)text {   // why the game cannot start, centered over the black screen
@@ -151,7 +164,12 @@
     const char *dev = front_ios_device_check();   // that first device: a GPU without BC textures is refused here, not at launch, so the launcher's HUD switch counts
     if (dev) { [self showHint:[NSString stringWithFormat:@"This device is not supported.\n%s", dev]]; return; }   // the host does not start
     self.fill = dm_picture_fill(getenv("DM_PICTURE_FIT"));
-    if (self.fill) LOG("front end: picture Fill (DM_PICTURE_FIT=fill), the 16:9 picture covers the screen in landscape and its edges are cropped");
+    if (self.fill) LOG("front end: picture Fill (DM_PICTURE_FIT=fill), the picture covers the screen in landscape and its edges are cropped");
+    // The picture's shape (DmLayout.h dm_view_aspect): 16:9 unless DM_VIEW_ASPECT moved it. One line at start, so a screenshot's log
+    // says which layout produced it; the present side of the same route logs its own choice (nvn_mtl.m present_viewport).
+    { CGFloat ar = dm_view_aspect();
+      if (ar <= 0) LOG("front end: picture shape Full (DM_VIEW_ASPECT=full): the game's view is the whole screen, no letterbox here; the present fills the canvas only when DM_PRESENT_FIT says so or the game's ratio is within DM_PRESENT_FIT_TOL");
+      else if (fabs((double)ar - 16.0 / 9.0) > 1e-4) LOG("front end: picture shape %.4g:1 (DM_VIEW_ASPECT), fitted into the screen", (double)ar); }
     self.view.clipsToBounds = YES;   // with Fill the game view is larger than the screen
     self.view.window.traitOverrides.preferredContentSizeCategory = UIContentSizeCategorySmall;   // UIKit draws the in-game menu (GameMenu.swift) in this window: it keeps one compact text size over the game, whatever the system's text size
     self.game = [[DmGameView alloc] initWithFrame:self.view.bounds];
@@ -167,6 +185,9 @@
     [self.view setNeedsLayout]; [self.view layoutIfNeeded];
     UIApplication.sharedApplication.idleTimerDisabled = YES;
     tv_attach();   // a TV connected while the launcher showed
+    // The host's loading began at launch (main.m), so the cheat load is deferred (DM_CHEATS_DEFER) until here: this screen
+    // has just written the file and DM_CHEATS_ON, and those are what it reads.
+    dm_cheats_after_launcher();
     front_ios_boot();
 }
 - (void)viewDidLayoutSubviews {
@@ -213,6 +234,11 @@
     }
     if (self.launched || !front_ios_boot_ok()) return;
     self.launched = YES; g_root = self;
+    if (dm_shell_library_needed()) {   // zero or several games: the library first, and the host starts only once one is picked
+        dm_show_library((__bridge void *)self, library_picked, library_cancelled);
+        front_ios_notify_ask();
+        return;
+    }
     if (!dm_show_launcher((__bridge void *)self, launcher_done)) [self startGame];   // the settings screen first (Launcher.swift), when the app has one
     front_ios_notify_ask();
 }
